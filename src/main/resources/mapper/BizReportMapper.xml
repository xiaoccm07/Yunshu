<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunshu.oa.dao.BizReportMapper">

    <select id="findById" resultType="com.yunshu.oa.entity.BizReport">
        select * from biz_report where id = #{id}
    </select>

    <update id="updateContent">
        update biz_report set content = #{content} where id = #{id}
    </update>
</mapper>
